# Copy to .env.local (git-ignored) to override. No secrets here.

# Where the Vite dev server proxies the backend's paths (/auth, /squad, /clubs, /users).
# Read only by vite.config.ts; not VITE_-prefixed, so it never reaches the browser bundle.
SQUADPULSE_BACKEND_URL=http://localhost:8080

# The backend's base URL as the app calls it, baked in at build time.
# Empty = the app's own origin: the dev proxy above, or a reverse proxy in production.
VITE_API_BASE_URL=
