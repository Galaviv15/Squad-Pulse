# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed to git (it's in .gitignore).
# This file only documents which variables exist — no real secrets here.

# --- docker-compose (local MongoDB + Redis) ---
MONGO_ROOT_USERNAME=squadpulse
MONGO_ROOT_PASSWORD=changeme-local-only
REDIS_PASSWORD=changeme-local-only

# --- Backend (Spring Boot) ---
# Connection strings the backend uses to reach the containers above.
# directConnection=true: the local MongoDB is a single-node replica set (see docker-compose.yml);
# this talks to that one node directly instead of going through replica-set discovery.
MONGODB_URI=mongodb://squadpulse:changeme-local-only@localhost:27017/squadpulse?authSource=admin&directConnection=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme-local-only

# JWT signing secret for Access/Refresh tokens (generate a long random value; never reuse across environments)
JWT_SECRET=replace-with-a-long-random-value

# Password hashing "pepper" — combined with Argon2id before hashing (see docs/spec.md section 10)
# Never reuse the JWT_SECRET value here — generate an independent random secret.
PASSWORD_PEPPER=replace-with-a-different-long-random-value

# The system owner's credential for creating a new club + its first Club Manager (the one-off
# "bootstrap" task — see README "Bootstrapping a new club"): what the owner types at its prompt is
# checked against this. Only the bootstrap profile reads it; the normal server doesn't need it.
# Generate an independent random value (at least 32 characters).
OWNER_BOOTSTRAP_SECRET=replace-with-a-third-long-random-value
