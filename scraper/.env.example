# Copy to scraper/.env (git-ignored) for local development; `npm start` loads it.
# This is the scraper's own file: never put the root .env's MongoDB / Redis credentials here.

# Required. The same value as the backend's SCRAPER_SERVICE_TOKEN (root .env): at least 32 characters,
# no whitespace. Generate one with: openssl rand -base64 48 | tr -d '\n'
SCRAPER_SERVICE_TOKEN=

# Optional. Where the backend runs (results go to <BACKEND_URL>/internal/scrape-results).
# BACKEND_URL=http://localhost:8080

# Optional. Where the trigger endpoint (POST /scrape) listens. Internal only: keep the loopback default
# unless the backend runs on another host.
# SCRAPER_PORT=8090
# SCRAPER_HOST=127.0.0.1
