{
  "name": "squadpulse-scraper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Internal service: scrapes one team's fixtures and its league table from football.org.il on the backend's request and posts the result to the backend (KAN-67).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.8"
  }
}
