# .env itself must NEVER be committed to git (it's in .gitignore).
# This file only documents which variables exist — no real secrets here.

# --- docker-compose (local MongoDB + Redis) ---
MONGO_ROOT_USERNAME=squadpulse
MONGO_ROOT_PASSWORD=mysecretpassword
REDIS_PASSWORD=mysecretpassword

# --- Backend (Spring Boot) ---
# Connection strings the backend uses to reach the containers above.
MONGODB_URI=mongodb://squadpulse:mysecretpassword@localhost:27017/squadpulse?authSource=admin
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mysecretpassword

# JWT signing secret for Access/Refresh tokens (generate a long random value; never reuse across environments)
JWT_SECRET=7yW9fK2qN5u8x/A4vL0mP3sT6wZ1eY8bC5dF7hJ9kL0=

# Password hashing "pepper" — combined with Argon2id before hashing (see docs/spec.md section 10)
# Never reuse the JWT_SECRET value here — generate an independent random secret.
PASSWORD_PEPPER=u9B6xQ2tV8yK1mP4sL7wZ0eC3dF6hJ8kL0mN2pQ4rT8=
